{
    "manifest_version": 3,
    "name": "Level Up Remastered",
    "version": "1.0",
    "description": "Provides custom functionality for Dynamics 365/Power Platform",
    "icons": {
        "16": "images/icon-16.png",
        "32": "images/icon-32.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    },
    "background": {
        "service_worker": "scripts/extension-service.js",
        "type": "module"
    },
    "host_permissions": ["https://*/*"],
    "permissions": ["scripting", "storage", "activeTab", "tabs"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/app.js"]
        }
    ],
    "action": {
        "default_title": "TO-DO: NAME",
        "default_popup": "pages/main.html"
    },
    "web_accessible_resources": [
        {
            "resources": ["scripts/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "externally_connectable": {
        "matches": ["https://*/*"]
    }
}
