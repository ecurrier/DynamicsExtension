{
    "manifest_version": 3,
    "name": "Power Up",
    "version": "1.0",
    "description": "Boost productivity & streamline workflows on Power Platform/Dynamics 365. Custom functionality & quality-of-life features.",
    "icons": {
        "16": "images/powerup2-16.png",
        "32": "images/powerup2-32.png",
        "48": "images/powerup2-48.png",
        "128": "images/powerup2-128.png"
    },
    "background": {
        "service_worker": "scripts/extension/extension-service.js",
        "type": "module"
    },
    "host_permissions": ["https://*/*"],
    "permissions": ["scripting", "storage", "activeTab", "tabs"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scripts/app/app.js"]
        }
    ],
    "action": {
        "default_title": "Power Up",
        "default_popup": "pages/main.html"
    },
    "web_accessible_resources": [
        {
            "resources": ["scripts/*"],
            "matches": ["<all_urls>"]
        }
    ],
    "externally_connectable": {
        "matches": ["https://*/*"]
    }
}
